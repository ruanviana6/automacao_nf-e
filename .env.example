# Copie este arquivo para .env e preencha somente no seu ambiente.
# O .env real NÃO deve ser enviado para o GitHub.

# Execução
MODO_SIMULACAO=true
USUARIO_EXECUCAO=

# SQLite
DB_BUSY_TIMEOUT_MS=10000

# API GestãoClick
GESTAOCLICK_BASE_URL=
GESTAOCLICK_ACCESS_TOKEN=
GESTAOCLICK_SECRET_ACCESS=
GESTAOCLICK_CONNECT_TIMEOUT=3.5
GESTAOCLICK_READ_TIMEOUT=30

# Configurações gerais
RETENCAO_ARQUIVOS_DIAS=45
RETENCAO_LOGS_DIAS=45
RELATORIO_DIAS=15
FUSO_HORARIO=America/Fortaleza

# E-mail
EMAIL_USUARIO=
EMAIL_SENHA=
EMAIL_DESTINO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_TLS=true
EMAIL_ENVIO_AUTOMATICO=false

# Integração futura com o Gerente de Estoque
# Mantenha false enquanto o gerente ainda estiver separado.
INTEGRACAO_GERENTE_ATIVA=false
GERENTE_ESTOQUE_WEBHOOK_URL=
GERENTE_ESTOQUE_WEBHOOK_SECRET=
GERENTE_ESTOQUE_WEBHOOK_TOKEN=
GERENTE_ESTOQUE_CONNECT_TIMEOUT=3.5
GERENTE_ESTOQUE_READ_TIMEOUT=10
