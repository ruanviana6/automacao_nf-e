# Copie somente para o ambiente seguro. NUNCA versionar o .env real.
MODO_SIMULACAO=true
USUARIO_EXECUCAO=
DB_BUSY_TIMEOUT_MS=10000

# Duas contas independentes. A integração real permanecerá bloqueada até
# confirmar OpenAPI, mapeamentos, regras fiscais e proteção contra duplicidade.
# Não compartilhar tokens de emissão com o Gerente de Estoque.
GESTAOCLICK_ATACADO_BASE_URL=
GESTAOCLICK_ATACADO_ACCESS_TOKEN=
GESTAOCLICK_ATACADO_SECRET_ACCESS=
GESTAOCLICK_VAREJO_BASE_URL=
GESTAOCLICK_VAREJO_ACCESS_TOKEN=
GESTAOCLICK_VAREJO_SECRET_ACCESS=
NFE_EMISSAO_REAL_HABILITADA=false
GESTAOCLICK_CONNECT_TIMEOUT=3.5
GESTAOCLICK_READ_TIMEOUT=30

# Configurações gerais
RETENCAO_ARQUIVOS_DIAS=45
RETENCAO_LOGS_DIAS=45
RELATORIO_DIAS=15
FUSO_HORARIO=America/Fortaleza

# E-mail
EMAIL_USUARIO=
EMAIL_SENHA=
EMAIL_DESTINO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_TLS=true
EMAIL_ENVIO_AUTOMATICO=false

# Envio de eventos: desativado até existir um receptor autenticado e testado.
INTEGRACAO_GERENTE_ATIVA=false
GERENTE_ESTOQUE_WEBHOOK_URL=
GERENTE_ESTOQUE_WEBHOOK_SECRET=
GERENTE_ESTOQUE_WEBHOOK_TOKEN=
GERENTE_ESTOQUE_CONNECT_TIMEOUT=3.5
GERENTE_ESTOQUE_READ_TIMEOUT=10
